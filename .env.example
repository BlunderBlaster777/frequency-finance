# ──────────────────────────────────────────────────────────────────
# Contracts (.env in project root)
# ──────────────────────────────────────────────────────────────────

# Deployer private key (never commit this)
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Sonic chain RPC (defaults to public endpoint)
SONIC_RPC=https://rpc.soniclabs.com
SONIC_TESTNET_RPC=https://rpc.blaze.soniclabs.com

# Sonicscan API key for contract verification (optional)
SONICSCAN_API_KEY=

# Enable gas reporter
REPORT_GAS=false

# ──────────────────────────────────────────────────────────────────
# Frontend (frontend/.env)
# ──────────────────────────────────────────────────────────────────

# WalletConnect project ID — get one at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Deployed aggregator router contract address (update after deployment)
VITE_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
